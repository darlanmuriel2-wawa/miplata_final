%%{init: {'theme':'base','themeVariables':{'darkMode':true,'background':'#0A1830','primaryColor':'#10243f','primaryTextColor':'#E8F1FF','primaryBorderColor':'#5b7fa6','lineColor':'#94a6c1','secondaryColor':'#10243f','tertiaryColor':'#10243f','fontFamily':'Arial','fontSize':'15px'},'class':{'hideEmptyMembersBox':true}}}%%
classDiagram
direction TB

class Usuario {
  -id : int
  -identificacion : String
  -nombre : String
  -celular : String
  -username : String
  -passwordHash : String
  -rol : String
  -estado : String
  -intentosFallidos : int
  +iniciarSesion() boolean
  +cerrarSesion() void
  +actualizarPerfil() void
  +cambiarPassword() void
}
class Cliente {
  +adicionarProducto() boolean
  +consultarSaldos() void
  +consultarExtracto() ExtractoMovimientos
  +transferir() ComprobanteTransferencia
}
class Administrador {
  +gestionarUsuarios() boolean
  +desbloquearCuenta() void
  +verMetricas() MetricasBanco
}
class Autenticacion {
  -MAX_INTENTOS = 3
  +registrarCliente(datos) Usuario
  +iniciarSesion(usuario, clave) Usuario
  +validarCredenciales() boolean
  +bloquearPorIntentos() void
}
class ProductoBancario {
  <<abstract>>
  -idProducto : int
  -numero : String
  -tipo : String
  -fechaCreacion : Date
  +consultarSaldo() Float
  +registrarMovimiento() void
}
class Cuenta {
  -saldo : Float
  -movimientos : Movimiento[]
  +consignar(monto) Float
  +retirar(monto) Float
}
class CuentaAhorros {
  -tasaInteres = 0.015
  +calcularInteres() Float
  +aplicarInteres() void
}
class CuentaCorriente {
  -sobregiroMax = 0.20
  +limiteRetiro() Float
  +validarSobregiro(monto) boolean
}
class TarjetaCredito {
  -numTarjeta : String
  -cupoTotal : Float
  -deudaActual : Float
  +cupoDisponible() Float
  +registrarCompra(valor, cuotas) CompraTarjeta
  +pagar(monto) void
}
class CompraTarjeta {
  -capital : Float
  -cuotas : int
  -tasa : Float
  -cuotaMensual : Float
  -saldoCapital : Float
  +calcularCuota() Float
}
class Movimiento {
  -id : int
  -fecha : DateTime
  -tipo : String
  -sentido : String
  -valor : Float
  -descripcion : String
  -transferenciaId : int
  +obtenerResumen() String
}
class Transferencia {
  -id : int
  -referencia : String
  -fecha : DateTime
  -valor : Float
  +validarCuentas(origen, destino) boolean
  +ejecutar() ComprobanteTransferencia
}
class ComprobanteTransferencia:::nuevo {
  <<nuevo>>
  -referencia : String
  -estado : String
  -origen : ParteTransferencia
  -destino : ParteTransferencia
  -numerosEnmascarados : boolean
  +generarReferencia() String
  +imprimir() void
}
class ExtractoMovimientos:::nuevo {
  <<nuevo>>
  -producto : String
  -desde : Date
  -hasta : Date
  -sentido : String
  +filtrar() Movimiento[]
  +resumen() Totales
  +exportarCSV() void
  +imprimir() void
}
class MetricasBanco:::nuevo {
  <<nuevo>>
  -usuarios : Conteos
  -dinero : Totales
  -operaciones : Conteos
  -series14Dias : Serie[]
  +resumen() Metricas
  +graficar() SVG
}

Usuario <|-- Cliente
Usuario <|-- Administrador
Autenticacion ..> Usuario : valida
Cliente "1" *-- "3" ProductoBancario : posee
ProductoBancario <|-- Cuenta
ProductoBancario <|-- TarjetaCredito
Cuenta <|-- CuentaAhorros
Cuenta <|-- CuentaCorriente
TarjetaCredito "1" *-- "0..*" CompraTarjeta : compras
ProductoBancario "1" *-- "0..*" Movimiento : historial
Transferencia "1" --> "2" Movimiento : genera
Transferencia "1" --> "1" ComprobanteTransferencia : emite
Cliente ..> Transferencia : realiza
Cliente ..> ExtractoMovimientos : consulta
ExtractoMovimientos ..> Movimiento : filtra
Administrador ..> MetricasBanco : consulta
MetricasBanco ..> Usuario : cuenta
MetricasBanco ..> Movimiento : agrega

classDef nuevo fill:#0b4a37,stroke:#00e5a0,stroke-width:3px,color:#E8F1FF
